{
  "rewrites": [
    { "source": "/", "destination": "/MainPortfolioPage/index.html" },
    { "source": "/resume", "destination": "/MainPortfolioPage/resume.html" },
    { "source": "/accessibility", "destination": "/MainPortfolioPage/accessibility.html" },
    { "source": "/privacy", "destination": "/MainPortfolioPage/privacy.html" },
    { "source": "/albums", "destination": "/AlbumReviewsWebsite/reviews.html" },
    { "source": "/albums/all", "destination": "/AlbumReviewsWebsite/all.html" },
    { "source": "/albums/stats", "destination": "/AlbumReviewsWebsite/stats.html" },
    { "source": "/albums/subscribe", "destination": "/AlbumReviewsWebsite/subscribe.html" },
    { "source": "/albums/review", "destination": "/AlbumReviewsWebsite/review.html" },
    { "source": "/albums/(.*)", "destination": "/AlbumReviewsWebsite/$1" },
    { "source": "/picoctf", "destination": "/picoCTFSolvesWebsite/index.html" },
    { "source": "/picoctf/solve", "destination": "/picoCTFSolvesWebsite/solve.html" },
    { "source": "/picoctf/category", "destination": "/picoCTFSolvesWebsite/category.html" },
    { "source": "/picoctf/(.*)", "destination": "/picoCTFSolvesWebsite/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://formspree.io https://cdn.jsdelivr.net; frame-src 'self'; worker-src 'self' blob:; form-action 'self' https://buttondown.com https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/picoctf/:dir(js|css|data)/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/picoctf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/picoctf/category",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/picoctf/solve",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/MainPortfolioPage/js/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
